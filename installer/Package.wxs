<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="opencut-classic"
    Manufacturer="figuesosa"
    Version="$(Version)"
    UpgradeCode="6F2A9C4E-8B17-4D35-A1E0-9C4B7F2D18A6"
    Scope="perMachine"
    Compressed="yes">
    <SummaryInformation Description="Local Windows package of OpenCut Classic. We did not develop OpenCut." />
    <MajorUpgrade DowngradeErrorMessage="A newer version of opencut-classic is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="opencut-classic" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="opencut-classic" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="B7E4A1C2-5D83-4F19-8A60-2C9E4B71D0F3">
      <Shortcut
        Id="ApplicationStartMenuShortcut"
        Name="opencut-classic"
        Description="Local OpenCut Classic editor"
        Target="[INSTALLFOLDER]opencut-classic.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\opencut-classic"
        Name="StartMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="C8F5B2D3-6E94-401A-9B71-3D0F5C82E104">
      <Shortcut
        Id="ApplicationDesktopShortcut"
        Name="opencut-classic"
        Description="Local OpenCut Classic editor"
        Target="[INSTALLFOLDER]opencut-classic.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
        Root="HKCU"
        Key="Software\opencut-classic"
        Name="DesktopShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Package>
</Wix>
